{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cognate Workbench",
  "identifier": "workbench.cognate.app",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/cognate-workbench"
    ],
    "createUpdaterArtifacts": false,
    "resources": [
      "resources/cognate-workbench"
    ]
  },
  "plugins": {}
}