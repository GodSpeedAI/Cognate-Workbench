// Storage representation may evolve; Expert identities, scopes and one-Orchestrator authority do not.
Instance j_memory_migrate of "CanonicalJourney" {
    actor: "OperatorAgent",
    capabilities: "expert.memory.write, expert.context",
    evidence_class: "observed",
    initiating_condition: "The native Expert aggregate approaches the event envelope limit or repeated full-snapshot writes create contention",
    journey_id: "J-MEMORY-MIGRATE",
    precondition: "Existing state and event history are intact; every retained item has immutable identity and scope",
    purpose: "Migrate storage representation into bounded native state partitions while preserving an atomic governed view and rebuildable public projection",
    settlement: "A substantial registry can exceed the former single-event limit; identities, receipts, private scopes and Team invariants survive migration and restart; interrupted preparation cannot publish partial state; old event history remains readable",
    steps: "measure current state -> prepare bounded immutable partitions through native state events -> compare-and-swap the registry manifest -> rebuild projections -> restart and verify all source identities, scopes and pending work",
    variants: "failure before manifest commit leaves old state current; competing writers revalidate against latest manifest; missing or hash-mismatched partition fails closed; rollback or recovery never rewrites source events"
}

