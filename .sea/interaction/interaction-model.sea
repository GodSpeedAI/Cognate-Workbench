// J-TERMINAL-* / J-BROWSER-* / J-PREVIEW-*: the desktop collaboration surfaces. `TerminalSession`
// is an ephemeral PTY-backed interactive session in a selected execution world; `BrowserSession`
// is one managed browser context that a person and an agent operate in turn; `DevPreview` is a
// registered development-server preview bound to a workspace. Only their metadata and transitions
// are durable — stream bytes, video frames and page contents are never persisted.
Entity "TerminalSession"

Entity "BrowserSession"

Entity "DevPreview"

Resource "PageFeedback" units

Flow "PageFeedback" from "User" to "OperatorAgent" quantity 1

Instance j_terminal_session of "CanonicalJourney" {
    actor: "User",
    capabilities: "terminal.open, terminal.close",
    evidence_class: "proposed",
    initiating_condition: "The operator wants to run interactive commands or full-screen terminal programs in one of the Workbench's execution worlds beside the conversation",
    journey_id: "J-TERMINAL-session",
    precondition: "A workspace is selected whose world is connected; the terminal is a human surface: agents keep tool.bash and cannot open, attach to or steer a terminal",
    purpose: "Give the operator a real interactive terminal (PTY) per execution world whose lifetime the operator controls and whose stream never enters the durable log or agent context",
    settlement: "Each open terminal is one PTY in the chosen world, labelled with its world and workspace; the operator resizes it, runs interactive programs, detaches without terminating, reattaches with bounded scrollback restored, and terminates it explicitly including its process group; a dead session is rendered dead after a restart; opening or attaching with another identity is refused; only metadata and transitions are recorded as events",
    steps: "operator opens the terminal surface -> terminal.open validates the operator, the world and containment and creates the PTY -> the terminal connects over an authenticated stream -> the operator types and the world answers -> terminal.close terminates the process group and records the transition -> or the surface detaches and the process keeps running until reattached or closed",
    variants: "local worlds under the contained posture stay open to the operator because the posture constrains agent effects, not the operator's own machine; SSH terminals verify the host key and reuse stored credentials; WSL terminals run through the established WSL provider; idle sessions are reaped after a configurable idle timeout; a world that disconnects ends its terminals as failed with the reason; scrollback is bounded and is not written to the event log"
}

