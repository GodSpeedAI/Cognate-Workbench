// Autonomous schedules are durable domain intent evaluated into existing native Expert runs.
// This does not grant parallel or multi-process execution authority.
Instance j_schedule_create of "CanonicalJourney" {
    actor: "User",
    capabilities: "schedule.save, schedule.manage, schedule.list",
    evidence_class: "observed",
    initiating_condition: "The operator wants an Expert or Team to perform a bounded objective later or repeatedly",
    journey_id: "J-SCHEDULE-CREATE",
    precondition: "The selected Expert or active Team, workspace and permitted access mode exist; the human can authorize the objective",
    purpose: "Persist versioned one-time or timezone-aware recurring intent with explicit misfire and backpressure policy",
    settlement: "Configuration, creator, revision and next due time are durable; edit, pause, resume, cancel and delete take effect through authorized mutations; execution history remains attributable",
    steps: "human selects target and workspace -> supplies objective, due rule and limits -> validates timezone and authority -> saves schedule -> inspects next occurrence or manages lifecycle",
    variants: "invalid timezone/time rejected; draft Team refused; paused schedule does not fire; deletion tombstones configuration but retains receipts; edits do not rewrite an existing occurrence"
}

