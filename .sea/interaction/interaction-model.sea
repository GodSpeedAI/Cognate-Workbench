Instance j_context_budget of "CanonicalJourney" {
    actor: "User",
    capabilities: "expert.save, expert.model.generate, settings.changeSpending",
    evidence_class: "observed",
    initiating_condition: "The operator needs to constrain an Expert's context, token consumption and model spend",
    journey_id: "J-CONTEXT-BUDGET",
    precondition: "The model route and optional declared token prices are inspectable; the complete visible request is available before provider invocation",
    purpose: "Freeze per-Assignment attempt limits and enforce conservative reservations before each model call while preserving observed usage separately",
    settlement: "Instructions, messages, tool schemas and reserved output are accounted for with the route's model-specific tokenizer named by its method label; an over-budget or over-ceiling call never reaches the provider; every dispatch holds a durable billing reservation that crash reconciliation settles, releases or books as unknown without blind repetition; provider-reported usage is retained as observed, unsupported tokenization as a labeled estimate, and unknown prices remain unknown everywhere including the global and ordinary-session spending ceilings",
    steps: "human configures optional context and attempt budgets and spending ceilings -> Assignment freezes limits -> tokenize the complete request with the route's tokenizer and reserve bounded output -> account prior successes and ambiguous failures -> enforce limits and ceilings -> reserve durably on the billing ledger before dispatch -> invoke provider -> record reported usage and settle the reservation -> reconcile interrupted reservations on restart -> inspect budget, reservation and ceiling status",
    variants: "unknown prices block a configured cost or spending ceiling; absent provider usage keeps a conservative reservation; provider failure still consumes a pessimistic reservation; an owner interrupted between reservation and dispatch requires reconciliation and never blindly repeats; replay does not charge a second logical invocation; pinned unresolved context cannot silently disappear"
}

Policy every_canonical_flow_recorded
    as: forall f in flows: (f.quantity > 0.0)

Metric "canonical_journey_count" as:
    COUNT(instances)
    @unit "count"

Instance j_expert_steer of "CanonicalJourney" {
    actor: "Human or authorized same-Team Expert",
    capabilities: "team.inbox.send, team.message, team.inbox.consume, team.inbox.cancel, expert.model.generate",
    evidence_class: "observed",
    initiating_condition: "An authorized sender addresses new information to a currently running same-Team Expert",
    journey_id: "J-EXPERT-STEER",
    precondition: "Recipient is an active member of the same Team and the target Assignment/run remains authorized; conversation is Team-scoped",
    purpose: "Make an addressed message available to the recipient's next model decision without interrupting an active provider call or widening Assignment authority",
    settlement: "Message has ordered sequence, correlation, sender, recipient and target Assignment; one run-boundary receipt atomically records the eligible batch and acknowledgements; replay returns the same batch",
    steps: "sender submits bounded addressed message -> mutation boundary revalidates sender, recipient, Team and Assignment -> CAS appends message -> running recipient reaches its next model decision -> recorded consume command CAS-commits boundary receipt and acknowledgements -> agent incorporates the batch as untrusted user content",
    variants: "cancelled or superseded messages are excluded; stale/duplicate consume returns recorded result; messages arriving during model generation wait for the next decision; no tool or authority set changes"
}

Instance j_expert_inbox_recover of "CanonicalJourney" {
    actor: "User or authorized same-Team Expert",
    capabilities: "team.inbox.send, team.message, team.inbox.consume, team.inbox.cancel, expert.context",
    evidence_class: "observed",
