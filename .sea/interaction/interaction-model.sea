// J-HARNESS-*: running a Session through an external agent-harness CLI installed on the machine
// the Workbench server runs on. `HarnessCli` is a detected executable (host-side detection);
// `HarnessBinding` is the durable operator choice that a Session runs through one. Neither widens
// authority: the native guarantees (per-tool authority checks, containment of the tool effects,
// protected-evidence blocking, settlement as agent.coding) do NOT apply to an external CLI.
Entity "HarnessCli"

Entity "HarnessBinding"

Instance j_harness_detect of "CanonicalJourney" {
    actor: "User",
    capabilities: "agent.harness.list",
    evidence_class: "proposed",
    initiating_condition: "The operator opens the place where an agent harness is chosen, or asks to refresh the list",
    journey_id: "J-HARNESS-detect",
    precondition: "The server runs on the host whose command-line tools are being detected; detection reads directories and runs only each tool's version probe",
    purpose: "Show which external agent-harness CLIs are installed on the machine the server runs on, truthfully, without starting a model or a sign-in",
    settlement: "Each catalog entry reports installed or not with its path and version when installed, its protocol, whether it can route permission requests through the Workbench, its permission modes, an install hint and a sign-in hint; detection happens on the server host and says so; results are cached briefly and refreshable on request; entries whose launch flags are not verified stay hidden unless the tool is present and its own help prints the flag; no model is called and no login is performed",
    steps: "operator opens the picker -> agent.harness.list reads PATH and known install folders on the host -> each found tool answers a bounded version probe -> the list returns entries with install and sign-in hints -> refresh bypasses the cache",
    variants: "a tool missing from the machine is listed as not installed with its install hint; a tool whose version probe times out is still listed as installed; a Windows command shim is resolved without a shell; detection never reflects an SSH, WSL or contained workspace's own machine"
}

Instance j_harness_session of "CanonicalJourney" {
    actor: "User",
