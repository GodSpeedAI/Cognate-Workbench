    precondition: "The app has started and chosen a secret storage backend",
    purpose: "Keep API keys in the operating system's secret store (Windows Credential Manager, Linux Secret Service, macOS Keychain) instead of a file, and say plainly which store is in use and why",
    settlement: "Keys written by secret.put live only in the selected backend, scoped per data home; Settings can state the backend and, for a fallback, the reason; no secret value is in any event, projection, configuration export or capability result",
    steps: "app starts -> the native store is probed -> it is selected, or the owner-only file is selected with a reason -> keys left in secrets.json are copied to the native store, verified by read-back, then the file is overwritten and removed -> the operator saves a key -> Settings shows the backend label",
    variants: "native store selected; no Secret Service or a locked keychain so the owner-only file is used with a stated reason; COGNATE_SECRET_STORE forces file or native; migration from secrets.json succeeds and removes the file; migration read-back mismatch keeps the file; two data homes on one machine never share keys"
}

Instance j_plg_install of "CanonicalJourney" {
    actor: "User",
    capabilities: "plugin.install, plugin.uninstall",
    evidence_class: "declared",
    initiating_condition: "The operator wants a catalogued plugin active in this deployment",
    journey_id: "J-PLG-install",
    precondition: "The Plugins panel is open",
    purpose: "Make installation a real lifecycle step: register, activate what the catalog declares, and be honest about what cannot run",
    settlement: "An installed plugin is durable, its enable state is honoured by whatever it actually drives, and a catalog entry with no executable implementation installs as inert and says so",
    steps: "operator chooses a catalog entry -> installs -> the plugin is registered and its declared implementation activated -> its enable switch now drives real behavior -> uninstalling reverses registration",
    variants: "entry with an executable implementation becomes toggleable; entry without one installs inert with a stated reason; installing an already-installed plugin is refused; arbitrary downloaded code is never executed"
}

// Cognitive navigation journeys are grounded in the executable J-COG runtime tests. They describe
// observed paths and deliberately keep human settlement distinct from reachable settlement.
Instance j_cog_cleanup of "CanonicalJourney" {
    actor: "User",
    capabilities: "case.open, criterion.freeze, world.freeze, world.fork, risk.assess, verification.run, case.derive, world.settle",
    evidence_class: "observed",
    initiating_condition: "The operator wants a desired repository change while preserving a known settled world",
    journey_id: "J-COG-cleanup",
    precondition: "A workspace and execution world are available; the operator can state an outcome and required checks",
    purpose: "Make a bounded candidate change, compare it with a frozen baseline, and decide from recorded verification evidence",
    settlement: "The candidate reaches a human-reviewable state; only an attributable human decision may move the settled head",
    steps: "open Case and declare checks -> freeze criterion and baseline -> fork a candidate world -> request and authorize consequential operations -> freeze candidate and run checks -> inspect deviations and repair -> human explicitly settles a verified candidate",
    variants: "restart reconstructs Case and world lineage from events; failed verification blocks settlement; denied or unresolved approval leaves the protected operation unapplied"
}

Instance j_cog_liveverify of "CanonicalJourney" {
    actor: "OperatorAgent",
    capabilities: "case.observe, world.freeze, verification.run, case.derive",
    evidence_class: "observed",
    initiating_condition: "A coding run makes a consequential change inside a Case with a frozen criterion and declared checks",
    journey_id: "J-COG-liveverify",
    precondition: "The Case has a settled baseline, a frozen criterion and checks declared before the change",
    purpose: "Observe the changed candidate and run its declared checks without relying on an unrecorded manual verification step",
    settlement: "Candidate identity and check results are recorded; failure exposes a repair affordance, while passing only makes human settlement reachable",
    steps: "coding run changes the workspace -> case observer hashes the candidate -> declared checks execute -> verification facts are recorded -> Case derivation exposes deviation or reachable settlement",
    variants: "unchanged work produces no new verification; failed checks keep settlement unreachable; a repair creates a distinct candidate and repeats verification"
}

Instance j_cog_attention of "CanonicalJourney" {
